# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Local data and secrets
.env
.env.*
!.env.example
*.db
*.sqlite
*.sqlite3
data/
evidence/
runs/

# Program configs are deployment-specific. Only the shipped examples and lab
# targets stay tracked; your own program YAMLs do not belong in the repo.
config/programs/*.yaml
!config/programs/example-acme-cloud.yaml
!config/programs/lab.yaml
!config/programs/dvwa.yaml
config/container/*.yaml
!config/container/lab.yaml
!config/container/dvwa.yaml

# Setup wizard / runtime state
setup.env
setup.json
blacklist.json

# Deploy secrets
deploy/*.local
deploy/.env

# Playwright / local screenshots (repo root only)
.playwright-mcp/
/deslop-*.png
/page-*.png

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
