# Intentionally vulnerable lab app image (additive build for lab-specific deps).
# Base image is the same as the production app; kept separate for clarity.
FROM python:3.12-slim

WORKDIR /app
COPY custom_app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY custom_app/app.py .

EXPOSE 8000
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
