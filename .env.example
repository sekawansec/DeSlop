# --- Core ---
DESLOP_ENV=dev
DESLOP_DATABASE_URL=postgresql+psycopg://deslop:deslop@localhost:5432/deslop
DESLOP_CONFIG_DIR=./config/programs

# --- LLM providers ---
# provider: anthropic | openai | ollama | none
DESLOP_LLM_PROVIDER=none
DESLOP_LLM_MODEL=
DESLOP_ANTHROPIC_API_KEY=
DESLOP_OPENAI_API_KEY=
DESLOP_OPENAI_BASE_URL=
DESLOP_OLLAMA_BASE_URL=http://localhost:11434
# For a fully local run with no outbound calls, keep provider=none and
# the local embedding model below (bge-m3) downloaded once.
DESLOP_LLM_MAX_RETRIES=2

# --- Embeddings (local by default) ---
DESLOP_EMBEDDING_PROVIDER=local
DESLOP_EMBEDDING_MODEL=BAAI/bge-m3
DESLOP_EMBEDDING_DIM=1024

# --- Execution limits ---
DESLOP_MAX_REQUESTS_PER_RUN=50
DESLOP_MAX_RUN_SECONDS=120
DESLOP_RATE_LIMIT_RPS=5
DESLOP_REPRO_HEADER=X-Repro-Validator
# Stamped on every reproduction request so target-side WAF/proxy logs can be
# correlated with the report being verified (value: deslop-repro-<run_id>).
DESLOP_BOUNTY_USER_HEADER=X-Bounty-User
# Reproduction against in-scope production hosts is denied unless this is true,
# the program sets allow_production, or a triager records approve_production.
DESLOP_ALLOW_PRODUCTION=false

# --- OOB listener ---
DESLOP_OOB_BASE_URL=http://oob.local:8080
DESLOP_OOB_LISTEN_HOST=0.0.0.0
DESLOP_OOB_LISTEN_PORT=8080

# --- Email (status page notifications) ---
DESLOP_EMAIL_ENABLED=false
DESLOP_SMTP_HOST=localhost
DESLOP_SMTP_PORT=1025
DESLOP_SMTP_USER=
DESLOP_SMTP_PASSWORD=
DESLOP_SMTP_FROM=deslop@example.test

# --- Dashboard auth ---
DESLOP_DASHBOARD_USER=admin
DESLOP_DASHBOARD_PASSWORD_HASH=
# Additional users (JSON). Roles: admin | triager | readonly.
# DESLOP_DASHBOARD_USERS_JSON=[{"username":"triager","password_hash":"<hash>","role":"triager"}]

# --- Notifications (outbound; leave blank to disable) ---
DESLOP_NOTIFY_ENABLED=false
DESLOP_SLACK_WEBHOOK_URL=
DESLOP_TELEGRAM_BOT_TOKEN=
DESLOP_TELEGRAM_CHAT_ID=
DESLOP_NOTIFY_BASE_URL=http://localhost:8000

# --- Intake anti-abuse ---
DESLOP_INTAKE_RATE_LIMIT=10
DESLOP_INTAKE_RATE_WINDOW_SECONDS=60
DESLOP_BLACKLIST_ENABLED=true
DESLOP_BLACKLIST_FILE=./data/blacklist.json

# --- Logging ---
DESLOP_LOG_LEVEL=INFO
DESLOP_LOG_JSON=false
DESLOP_LOG_FILE=

