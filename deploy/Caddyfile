# Caddy reverse proxy for DeSlop.
#
# Automatic HTTPS via Let's Encrypt for the domain in {$DESLOP_DOMAIN}.
# Caddy handles certificate issuance and renewal automatically.

{$DESLOP_DOMAIN} {
	encode zstd gzip

	# Security headers.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# Proxy everything to the DeSlop web app.
	reverse_proxy web:8000

	# Access + error logs (rotated by Docker's json-file driver).
	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
