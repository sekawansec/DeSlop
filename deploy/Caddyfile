{$DESLOP_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy web:8000

	log {
		output file /data/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
